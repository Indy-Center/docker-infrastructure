# The variables this app reads at runtime. Names only; never put values here.
# Each one needs two things:
#   - a repo secret (or, if it isn't secret, a repo variable) named ENV_<NAME>, and
#   - a matching line in the "Write .env" step of .github/workflows/build-and-deploy.yml.
# ENV_DATABASE_URL below becomes DATABASE_URL in the .env the deploy writes on the VPS.
DATABASE_URL=
LOG_LEVEL=
