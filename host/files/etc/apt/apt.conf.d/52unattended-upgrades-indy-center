// Managed by docker-infrastructure's host/ (apply.sh). Comes after Ubuntu's own
// 50unattended-upgrades, and replaces its list of what to install.

// Security updates only. Docker's packages are held, so they never upgrade here either.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Allowed-Origins {
  "${distro_id}:${distro_codename}-security";
  "${distro_id}ESMApps:${distro_codename}-apps-security";
  "${distro_id}ESM:${distro_codename}-infra-security";
};

// Never reboot: an admin reboots by hand at a quiet time, and the backup report says
// when one is needed.
Unattended-Upgrade::Automatic-Reboot "false";
